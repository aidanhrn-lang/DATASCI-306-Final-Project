# ---- SERVER ----
server <- function(input, output, session) {
  
  # 1) Filter base data by user inputs ---------------------------------
  filtered_nfl <- reactive({
    df <- nfl_prepped
    
    # Season
    df <- df %>%
      filter(season >= input$season_range[1],
             season <= input$season_range[2])
    
    # Temperature category
    if (input$temp_cat == "cold") {
      df <- df %>% filter(temp < 40)
    } else if (input$temp_cat == "cool") {
      df <- df %>% filter(temp >= 40, temp <= 59)
    } else if (input$temp_cat == "warm") {
      df <- df %>% filter(temp >= 60, temp <= 75)
    } else if (input$temp_cat == "hot") {
      df <- df %>% filter(temp > 75)
    }
    
    # Wind category
    if (input$wind_cat == "calm") {
      df <- df %>% filter(wind <= 5)
    } else if (input$wind_cat == "breezy") {
      df <- df %>% filter(wind > 5, wind <= 15)
    } else if (input$wind_cat == "windy") {
      df <- df %>% filter(wind > 15)
    }
    
    # Home rest category
    if (input$home_rest_cat == "short") {
      df <- df %>% filter(home_rest <= 6)
    } else if (input$home_rest_cat == "normal") {
      df <- df %>% filter(home_rest >= 7, home_rest <= 10)
    } else if (input$home_rest_cat == "long") {
      df <- df %>% filter(home_rest >= 11)
    }
    
    # Away rest category
    if (input$away_rest_cat == "short") {
      df <- df %>% filter(away_rest <= 6)
    } else if (input$away_rest_cat == "normal") {
      df <- df %>% filter(away_rest >= 7, away_rest <= 10)
    } else if (input$away_rest_cat == "long") {
      df <- df %>% filter(away_rest >= 11)
    }
    
    # Grass filter
    if (input$grass_filter == "yes") {
      df <- df %>% filter(grass == 1)
    } else if (input$grass_filter == "no") {
      df <- df %>% filter(grass == 0)
    }
    
    # Indoor filter
    if (input$indoor_filter == "yes") {
      df <- df %>% filter(indoor == 1)
    } else if (input$indoor_filter == "no") {
      df <- df %>% filter(indoor == 0)
    }
    
    # Weekend / weekday
    if (input$weekend_filter == "weekend") {
      df <- df %>% filter(weekend == 1)
    } else if (input$weekend_filter == "weekday") {
      df <- df %>% filter(weekend == 0)
    }
    
    # Time of day
    if (input$time_of_day == "noon") {
      df <- df %>% filter(noon == 1)
      
    } else if (input$time_of_day == "afternoon") {
      df <- df %>% filter(afternoon == 1)
      
    } else if (input$time_of_day == "both") {
      # Do not filter; keep all noon + afternoon
      df <- df
    }
    
    validate(
      need(nrow(df) > 0,
           "Not enough historical games for these conditions — please relax your filters.")
    )
    
    df
  })
  
  # 2) Model + predictability pipeline (auto-updates on any filter change) --
  results <- reactive({
    nfl <- filtered_nfl()
    
    # Mixed-effects model
    model_game <- lmer(
      margin ~ temp + wind + grass + indoor +
        weekend + noon + afternoon +
        spread_line + home_rest + away_rest +
        (1 | home_team) + (1 | away_team),
      data = nfl
    )
    
    nfl <- nfl %>%
      mutate(
        resid     = resid(model_game),
        abs_resid = abs(resid)
      )
    
    # Home / away or both
    game_team <- nfl %>%
      dplyr::select(season, abs_resid, home_team, away_team) %>%
      pivot_longer(
        cols      = c(home_team, away_team),
        names_to  = "side",
        values_to = "team"
      ) %>%
      mutate(team = factor(team))
    
    if (input$team_side == "home") {
      game_team <- game_team %>% filter(side == "home_team")
    } else if (input$team_side == "away") {
      game_team <- game_team %>% filter(side == "away_team")
    }
    
    # Team filter (after pivot_longer)
    if (!is.null(input$team_filter) && length(input$team_filter) > 0) {
      game_team <- game_team %>%
        filter(as.character(team) %in% input$team_filter)
    }
    
    validate(
      need(nrow(game_team) > 0,
           "Not enough games for the selected team(s) under these conditions — please relax filters or add more teams.")
    )
    
    # 5-year windows
    game_team <- game_team %>%
      mutate(
        window_start = season - 4,
        window_end   = season,
        window_mid   = season - 2,
        window_label = paste0(window_start, "-", window_end)
      ) %>%
      filter(window_start >= 1999)
    
    team_window_stab <- game_team %>%
      group_by(team, window_start, window_end, window_mid, window_label) %>%
      summarise(
        n_games        = n(),
        mean_abs_resid = mean(abs_resid, na.rm = TRUE),
        .groups        = "drop"
      ) %>%
      filter(n_games >= input$min_games)
    
    validate(
      need(
        nrow(team_window_stab) > 0,
        "Not enough games per 5-year window for these settings — please relax your filters or lower the 'Minimum games per window'."
      )
    )
    
    # Team-level predictability
    team_predictability <- team_window_stab %>%
      group_by(team) %>%
      summarise(
        overall_volatility = weighted.mean(mean_abs_resid, w = n_games, na.rm = TRUE),
        .groups = "drop"
      ) %>%
      arrange(overall_volatility)
    
    # Trend results
    trend_results <- team_window_stab %>%
      group_by(team) %>%
      do(tidy(lm(mean_abs_resid ~ window_mid, data = .))) %>%
      filter(term == "window_mid") %>%
      arrange(estimate) %>%
      mutate(
        sig_level = case_when(
          p.value < 0.01 ~ "Highly Significant (p < 0.01)",
          p.value < 0.05 ~ "Significant (p < 0.05)",
          p.value < 0.10 ~ "Marginally Significant (p < 0.10)",
          TRUE           ~ "Not Significant (p ≥ 0.10)"
        ),
        sig_level = factor(
          sig_level,
          levels = c(
            "Highly Significant (p < 0.01)",
            "Significant (p < 0.05)",
            "Marginally Significant (p < 0.10)",
            "Not Significant (p ≥ 0.10)"
          )
        )
      )
    
    list(
      team_window_stab = team_window_stab,
      team_predictability   = team_predictability,
      trend_results    = trend_results,
      model_game       = model_game
    )
  })
  
  # 3) Outputs ---------------------------------------------------------
  
  output$stab_plot <- renderPlot({
    res <- results()
    team_window_stab <- res$team_window_stab
    
    ggplot(team_window_stab,
           aes(x = window_end,
               y = mean_abs_resid,
               group = team,
               colour = team)) +
      geom_line(size = 0.7, alpha = 0.9) +
      facet_wrap(~ team, scales = "fixed") +
      scale_x_continuous(
        breaks = seq(2003, 2024, by = 5),
        labels = function(v) {
          sapply(v, function(z) {
            paste(strsplit(as.character(z), "")[[1]], collapse = "\n")
          })
        }
      ) +
      scale_y_continuous(breaks = seq(4, 20, by = 4)) +
      labs(
        title = "5-Year Rolling Predictability Trend by Team",
        x = "Window Ending Year",
        y = "Mean Absolute Residual (Lower = More Predictable)"
      ) +
      theme_minimal(base_size = 11) +
      theme(
        plot.margin = margin(t = 5, r = 5, b = 5, l = 20),
        axis.text.y = element_text(size = 6),
        axis.text.x = element_text(size = 6, lineheight = 0.7)
      )
  })
  
  output$stab_table <- renderDT({
    res <- results()
    df  <- res$team_predictability
    
    datatable(
      df,
      options = list(pageLength = 32),
      rownames = FALSE
    )
  })
  
  output$trend_plot <- renderPlot({
    res <- results()
    trend_results <- res$trend_results
    
    sig_colors <- c(
      "Highly Significant (p < 0.01)"     = "#00FFCC",
      "Significant (p < 0.05)"            = "#ffc855",
      "Marginally Significant (p < 0.10)" = "#fec00b",
      "Not Significant (p ≥ 0.10)"        = "gray70"
    )
    
    ggplot(trend_results,
           aes(x = estimate,
               y = reorder(team, estimate),
               color = sig_level)) +
      geom_point(size = 3) +
      geom_vline(xintercept = 0, linetype = "dashed") +
      scale_color_manual(values = sig_colors) +
      labs(
        title = "Long-Term Predictability Trend by Team (1999–2024)",
        x = "Slope of Mean Absolute Residual\n(Negative = Becoming More Predictable, Positive = Less Predictable)",
        y = "Team",
        color = "Significance Level"
      ) +
      theme_minimal(base_size = 12) +
      theme(
        legend.position = "right",
        plot.title = element_text(size = 18, face = "bold"),
        axis.title.x = element_text(size = 12),
        axis.title.y = element_text(size = 12)
      )
  })
  
  output$trend_table <- renderDT({
    res <- results()
    df  <- res$trend_results
    
    datatable(
      df,
      options = list(pageLength = 32),
      rownames = FALSE
    )
  })
  
  output$model_summary <- renderPrint({
    res <- results()
    summary(res$model_game)
  })
}

# ---- Run the app ----
shinyApp(ui = ui, server = server)
