# app.R ---------------------------------------------------------------
# Shiny app: NFL team predictability with adjustable conditions (categorical filters)

# ---- Packages ----
library(shiny)
library(shinythemes)
library(dplyr)
library(tidyr)
library(lme4)
library(nflreadr)
library(DT)
library(ggplot2)
library(broom)

# ---- GLOBAL DATA PREP (runs once) -----------------------------------
nflgames_raw <- nflreadr::load_schedules(1999:2025)

nfl_prepped <- nflgames_raw %>%
  filter(
    season >= 1999, season <= 2024,
    !is.na(home_score),
    !is.na(away_score)
  ) %>%
  mutate(
    margin = home_score - away_score,
    grass  = if_else(grepl("grass", surface, ignore.case = TRUE), 1, 0),
    indoor = if_else(roof %in% c("dome", "closed"), 1, 0),
    
    hour = suppressWarnings(as.numeric(substr(gametime, 1, 2))),
    hour_clean = if_else(is.na(hour), -1, hour),
    
    noon      = if_else(hour_clean >= 11 & hour_clean < 14, 1, 0),
    afternoon = if_else(hour_clean >= 14 & hour_clean < 19, 1, 0),
    
    weekday = tolower(weekday),
    weekend = if_else(weekday %in% c("saturday", "sunday"), 1, 0),
    
    home_team = factor(home_team),
    away_team = factor(away_team)
  ) %>%
  drop_na(
    margin, temp, wind, spread_line,
    home_rest, away_rest,
    grass, indoor, noon, afternoon, weekend
  ) %>%
  mutate(
    home_team = dplyr::recode(
      home_team,
      "STL" = "LA",
      "SD"  = "LAC",
      "OAK" = "LV"
    ),
    away_team = dplyr::recode(
      away_team,
      "STL" = "LA",
      "SD"  = "LAC",
      "OAK" = "LV"
    )
  )

# All team names for selector
all_teams <- sort(unique(c(as.character(nfl_prepped$home_team),
                           as.character(nfl_prepped$away_team))))

